# Required
DATABASE_URL="file:./dev.db"          # SQLite path, relative to prisma/
SESSION_SECRET=""                     # 16+ random characters; required when NODE_ENV=production

# Seed (optional: random passwords are generated and printed once if unset)
ADMIN_PASSWORD=""
SECRETARY_PASSWORD=""

# AI phone line via Vapi (optional)
VAPI_API_KEY=""
VAPI_PHONE_NUMBER=""
VAPI_SECRET=""
VAPI_IP_ALLOWLIST=""
VAPI_WEBHOOK_BASE=""
NEXT_PUBLIC_VAPI_PUBLIC_KEY=""
NEXT_PUBLIC_VAPI_ASSISTANT_ID=""

# WhatsApp alerts via Meta Cloud API (optional: messages are only logged without these)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
ADMIN_WHATSAPP=""
ADMIN_PHONE=""
